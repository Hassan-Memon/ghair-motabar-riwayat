{
  "name": "tehqeqat-offline",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace apps/app run start",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspace apps/app run lint",
    "content:build": "npm --workspace packages/content run build-snapshot",
    "content:pull": "npm --workspace packages/content run pull --"
  }
}
