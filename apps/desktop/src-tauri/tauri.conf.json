{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tehqeeqat-e-Hadees",
  "version": "1.0.0",
  "identifier": "com.tehqeqatehadees.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm --prefix ../.. --workspace apps/app run export:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "تحقیقاتِ حدیث",
        "width": 1100,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Offline reader of tehqeqatehadees.com",
    "category": "Education"
  }
}
